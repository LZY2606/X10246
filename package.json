{
  "name": "interferometry-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "光学干涉/相位展开/标定复核系统：包裹相位导入、二维相位展开切口审阅、整周候选裁定与表面高度转换链",
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen-samples": "esbuild scripts/gen-samples.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-samples.mjs && node node_modules/.cache/gen-samples.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}